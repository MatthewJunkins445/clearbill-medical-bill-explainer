{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/clearbill/samples/ground-truth.schema.json",
  "title": "ClearBill synthetic sample ground truth",
  "description": "Ground truth for one synthetic sample bill. Offsets are 0-based, end-exclusive JavaScript string indices into bill.txt (ASCII, so code units equal bytes).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "synthetic", "kind", "description", "files", "approxTokens",
               "pii", "mustKeep", "lineItems", "totals", "plantedIssues", "tags"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "synthetic": {"const": true},
    "kind": {"enum": ["itemized_bill", "eob", "summary_statement", "not_medical"]},
    "description": {"type": "string", "minLength": 1},
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"const": "bill.txt"},
        "pdf": {"const": "bill.pdf"},
        "image": {"const": "bill.png"}
      }
    },
    "approxTokens": {"type": "integer", "minimum": 1},
    "pii": {"type": "array", "items": {"$ref": "#/$defs/pii"}},
    "mustKeep": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "reason"],
        "properties": {
          "value": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "lineItems": {"type": "array", "items": {"$ref": "#/$defs/lineItem"}},
    "totals": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["charges", "adjustments", "insurancePaid", "patientResponsibility"],
      "properties": {
        "charges": {"type": "number"},
        "adjustments": {"type": "number"},
        "insurancePaid": {"type": "number"},
        "patientResponsibility": {"type": "number"}
      }
    },
    "plantedIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "lineIndexes", "note"],
        "properties": {
          "type": {"enum": ["DUPLICATE_CHARGE", "MATH_ERROR", "POSSIBLE_UPCODING",
                            "POSSIBLE_UNBUNDLING", "NO_ITEMIZATION", "OUT_OF_NETWORK_SURPRISE",
                            "SERVICE_NOT_RECEIVED_CHECK", "OTHER"]},
          "lineIndexes": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}}
  },
  "$defs": {
    "pii": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "value", "mustRedact", "occurrences"],
      "properties": {
        "category": {"enum": ["PATIENT_NAME", "PERSON_NAME", "PROVIDER_NAME", "FACILITY_NAME",
                              "DOB", "ADDRESS", "PHONE", "EMAIL", "SSN", "MEMBER_ID",
                              "ACCOUNT_NUMBER", "DIAGNOSIS", "OTHER_ID"]},
        "value": {"type": "string", "minLength": 1},
        "mustRedact": {"type": "boolean"},
        "occurrences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "lineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceDate", "code", "codeSystem", "description", "units", "charge",
                   "insurancePaid", "patientOwes"],
      "properties": {
        "serviceDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "code": {"type": "string", "minLength": 1},
        "codeSystem": {"enum": ["CPT", "HCPCS", "REVENUE"]},
        "description": {"type": "string", "minLength": 1},
        "units": {"type": "integer", "minimum": 1},
        "charge": {"type": "number", "minimum": 0},
        "insurancePaid": {"type": "number", "minimum": 0},
        "patientOwes": {"type": "number", "minimum": 0}
      }
    }
  }
}
