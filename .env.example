# Copy to .env.local (git-ignored) and fill in your own values. Never commit .env.local.
# Firebase console > Project settings > Your apps > (web app) > SDK setup and configuration.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# reCAPTCHA Enterprise site key registered with App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your-recaptcha-enterprise-site-key

# App Check debug token for local development only; the app reads it only in `npm run dev`.
# Register it under App Check > Apps > Manage debug tokens. Never put it in a production env.
VITE_APPCHECK_DEBUG_TOKEN=your-debug-token

# Development and tests only: set VITE_AI_MODE=mock to select the deterministic AI mock
# (src/ai/mock). The only accepted value is `mock`; leave it unset otherwise. This is not an
# inference mode: per-feature hybrid modes come from Remote Config, owned by ai.
# VITE_AI_MODE=mock
